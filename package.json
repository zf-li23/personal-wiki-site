{
  "name": "personal-wiki-site",
  "private": true,
  "version": "1.0.0",
  "description": "Bilingual (zh/en) personal knowledge base. Content in content/, pipeline in scripts/wiki/, client in src/.",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 vite",
    "build": "tsc -p . && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "preview": "vite preview",
    "wiki": "node --max-old-space-size=8192 scripts/wiki.ts",
    "check": "node --max-old-space-size=8192 scripts/wiki.ts build --strict && tsc -p . && eslint . && node --test \"scripts/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "node --test \"scripts/**/*.test.ts\"",
    "setup:python": "uv venv --allow-existing .venv && uv pip install --python .venv -r scripts/wiki/plot/requirements.txt"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "katex": "0.16.47",
    "lucide-react": "^1.56.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "github-slugger": "^2.0.0",
    "globals": "^17.13.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.1",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vite": "^7.3.7",
    "yaml": "^2.9.1"
  }
}
